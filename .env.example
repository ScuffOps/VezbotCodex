# ═══════════════════════════════════════
# VezbotCodex — Environment Variables
# ═══════════════════════════════════════
# Copy this file to .env and fill in values.
# Never commit .env to version control.

# ── Required ──────────────────────────
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_application_id_here
DATABASE_URL=postgresql://user:password@host:5432/vezbot?schema=public

# ── Optional ──────────────────────────
# NODE_ENV=production
# LOG_LEVEL=info

# ── Dashboard Only (not needed for bot) ──
# DISCORD_CLIENT_SECRET=your_client_secret_here
# NEXTAUTH_SECRET=generate_a_random_string
# NEXTAUTH_URL=https://your-dashboard-domain.up.railway.app
